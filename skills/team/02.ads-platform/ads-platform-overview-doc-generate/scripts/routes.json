          "name": "wait-product-selector",
          "selector": "*[data-testid='product-selector-modal']"
        },
        {
          "type": "click",
          "name": "show-all-products",
          "selector": "*[data-testid='product-selector-modal-show-without-exist-ad-only-checkbox']",
          "wait_ms": 3000
        },
        {
          "type": "click",
          "name": "select-all-products",
          "selector": ".product-modal .eds-table__header .eds-checkbox__indicator",
          "wait_ms": 1000
        },
        {
          "type": "click",
          "name": "product-selector-confirm",
          "selector": ".product-modal .eds-modal__footer .eds-button--primary",
          "wait_ms": 3000
        },
        {
          "type": "wait",
          "name": "product-selector-hide",
          "wait_for": "*[data-testid='product-selection-panel']",
          "wait_ms": 1000
