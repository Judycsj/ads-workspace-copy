      "doc": {
        "section_id": "4.1.2",
        "images": [
          { "source": "creation-gms", "caption": "GMS Ads Creation Flow" },
          { "source": "creation-ad-group", "caption": "Ad Group Creation Flow" },
          { "source": "creation-individual", "caption": "Individual Ads Creation Flow" }
        ]
      },
      "steps": [
        {
          "type": "wait",
          "name": "creation-page-ready",
          "wait_for": "*[data-testid='product-selection-panel']"
        },
        {
          "type": "click",
          "name": "switch-to-gms",
          "selector": "*[data-testid='tab-selection-gms']",
          "wait_ms": 1000
        },
        {
          "type": "screenshot",
          "name": "creation-gms",
          "screenshot": true,
          "screenshot_name": "creation-gms",
          "screenshot_height": 20000
        },
        {
          "type": "click",
          "name": "switch-to-ad-group",
          "selector": "*[data-testid='tab-selection-manual_mpd']",
