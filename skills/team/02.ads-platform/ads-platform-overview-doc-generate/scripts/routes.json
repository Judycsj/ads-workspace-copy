        {
          "type": "screenshot",
          "name": "creation-ad-group",
          "screenshot": true,
          "screenshot_name": "creation-ad-group",
          "screenshot_height": 20000
        },
        {
          "type": "click",
          "name": "switch-to-individual",
          "selector": "*[data-testid='tab-selection-manual']",
          "wait_ms": 1000
        },
        {
          "type": "screenshot",
          "name": "creation-individual",
          "screenshot": true,
          "screenshot_name": "creation-individual",
          "screenshot_height": 20000
        }
      ]
