          "wait_ms": 300
        },
        {
          "name": "overview-module",
          "type": "screenshot",
          "description": "Monthly snapshot of the Seller Center Ads landing overview.",
          "screenshot": true,
          "screenshot_height": 1200,
          "screenshot_name": "overview-module",
          "highlight": [
            { "selector": "*[data-testid='create-new-ads-btn']", "label": "A" },
            { "selector": "*[data-testid='account-panel']", "label": "B" },
            { "selector": ".smart-voucher-card", "label": "C" },
